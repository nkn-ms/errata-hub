generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator erd {
  provider                   = "prisma-erd-generator"
  output                     = "../docs/erd.svg"
  includeRelationFromFields  = true
}

datasource db {
  provider = "postgresql"
}

enum ReportType {
  ERRATA     // 正誤情報（誤字脱字・誤植を含む訂正系）
  SUGGESTION // 改善提案（読みにくい・わかりにくい等、より良い表現の提案）
  OTHER      // その他
}

// 読んだ媒体。位置情報の入力欄はこれに応じて変わる（PAPER=ページ・行、EBOOK=位置No等、OTHER=自由記述）
enum Medium {
  PAPER // 紙の書籍
  EBOOK // 電子書籍（Kindle等。版・刷を持たず同一商品に上書き配信される）
  OTHER // PDF・Web資料など
}

// ステータスは一本道の進行で、到達した「最も先の状態」を表す（後戻りさせない）。
// PENDING → FORWARDED → LISTED → FIXED。詳細は docs/design.md §7。
enum ReportStatus {
  PENDING     // 未対応（管理者未確認）
  FORWARDED   // 出版社へ連絡済み（回答が来たかは publisherComment の有無で分かる）
  LISTED      // 出版社の正誤表に掲載された（＝出版社が誤りと公式に認めた。紙の本での現実的なゴール）
  WILL_FIX    // 修正予定（正誤表には未掲載だが「次の刷で直す」と回答があった等）
  FIXED       // 実物が修正済み（重版=刷 / 改訂版 / 電子版の更新。fixedEdition / fixedPrinting が付随）
  WONT_FIX    // 修正なし（出版社が修正しないと判断）
  DISMISSED   // 却下（管理者が無効な投稿と判断。削除も非公開もせず公開のまま残す = docs/moderation-policy.md）
  OTHER       // その他（上記で表せない事情。publisherComment での説明を必須にしている = actions/report.ts）
}

enum Role {
  ADMIN
  USER
}

model Profile {
  id             String           @id // Supabase auth.users の UUID と一致
  // auth.users削除後も操作履歴を追跡するための記録用（Auth側と二重管理は意図的）。
  // 退会時は deleted-<uuid>@deleted.local に書き換わり、この接尾辞が退会判定の唯一のソース（src/lib/withdrawal.ts）。
  // 「壊れたデータ」ではないので直接UPDATEで修復しないこと。既知の罠: 退会者と同じメールでの再登録は @unique 衝突で失敗する（docs/learnings.md）
  email          String           @unique
  // 公開表示名（投稿者名として使用）。意図的にnullable — 必須化しないこと（docs/design.md「削除と退会」参照）。
  // null の主な源は退会スクラブ。OAuth初回作成で氏名系metadataが皆無の場合もnullになり得る（表示は「匿名」フォールバック）。
  // 退会判定の正はこの列ではなく email の匿名接尾辞
  displayName    String?
  githubUsername String?          // 公開リンク用（本人が任意で入力。ログイン手段とは独立。退会時にスクラブ = actions/auth.ts withdraw）
  xUsername      String?          // 公開リンク用（X / Twitter。任意。退会時にスクラブ）
  role           Role             @default(USER)
  // 利用規約・プライバシーポリシーへの同意の記録。Profile 作成時（/auth/callback の初回 upsert）に刻む。
  // 同意自体は規約第2条の「利用することにより同意したものとみなす」建て付けで成立しており、
  // この2列は「いつ・どの版に同意したか」を後から示せるようにするための記録。
  // nullable なのは、この列を足す前に登録した既存ユーザーの分を遡って作れないため（null=記録なし）。
  termsAgreedAt  DateTime?
  // 同意した時点の規約の版。正は src/constants/legal.ts の TERMS_VERSION（規約本文を改訂したら上げる）。
  termsVersion   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  publisherAccess PublisherAccess[]
  reports      Report[]
  upvotes      Upvote[]
}

model Publisher {
  id              String           @id @default(uuid())
  name            String           @unique // 名前で upsert して名寄せする（同時投稿での重複作成を防ぐ）
  email           String?          // 連絡先（管理者が正誤の連絡に使う。表示は管理画面のみ・公開ページには出さない）
  emailDomain     String?          // 自動権限付与用ドメイン (例: "oreilly.co.jp")
  note            String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  books           Book[]
  publisherAccess PublisherAccess[]
}

// ユーザーと出版社の多対多。付与経路は2つ:
//   1) 管理者が手動で付与・剥奪（/admin/users）
//   2) ログイン時に Publisher.emailDomain とメールドメインが一致すると自動付与（auth/callback）
// 現状は表示のみに使い、権限は何もゲートしない（権限に使う際は検証つき付与への見直しが前提。docs/design.md §2）
model PublisherAccess {
  id          String    @id @default(uuid())
  profileId   String
  publisherId String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  // 付与の出所。「なぜこの人がこの出版社の権限を持つのか」を後から説明するために行が自分で持つ。
  // AuditLog にも GRANT_PUBLISHER_ACCESS として残るが、あちらは全履歴で、targetId が profileId・
  // 出版社は after の JSON の中にあるため、現在の状態を出すには向かない（イベント列から
  // 組み立て直すことになる）。表示はこの列、履歴は AuditLog、と役割を分ける。
  //
  // ⚠️ null は「記録が無い」。廃止したドメイン一致の自動付与（監査ログを書いていなかった）で
  //    付いた行がこれに当たるので、画面では「記録なし」と示して手掛かりにする。
  //    Profile を消さない設計（退会は匿名化）なので、付与者は関連ではなく値で持つ
  //    ＝管理者が退会しても「誰が付けたか」の記録が消えない。
  grantedById    String?
  grantedByEmail String?

  @@unique([profileId, publisherId])
  // profileId 側は上の複合ユニーク（先頭列）で兼ねられるが、publisherId 側は先頭ではないので効かない。
  // Publisher 削除時の Cascade がここを参照する
  @@index([publisherId])
}

model Book {
  id            String     @id @default(uuid())
  publisherId   String?
  // 意図的に Restrict（optionalの既定 SetNull から変更）: 書籍が紐づく出版社は削除不可（出版社削除ガード）。
  // UX側の件数チェックは app/actions/publisher.ts、最終保証はこの制約が担う
  publisher     Publisher? @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  title         String
  author        String?
  isbn          String     @unique // ISBN-13 に正規化して保存（本の同一性の基準）
  coverImageUrl String?
  // 出版社の公式な正誤表ページ。正誤表は「本ごとに1ページ」なので Report ではなく Book に持つ
  // （Report ごとに持つと同じ URL が重複し、移転時に直し漏れる）。編集は管理者のみ（読者の申告は
  // Report.reportedErratumUrl に入り、管理者が採用してここへ昇格させる）。
  erratumUrl    String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  reports     Report[]

  // onDelete: Restrict の削除ガードが Publisher 削除のたびに参照側（Book）を走査するため
  @@index([publisherId])
}

model Report {
  id               String         @id @default(uuid())
  userId           String
  // onDelete未指定 = Restrict（意図的）。退会は Profile 削除ではなく PII スクラブ（匿名化）で行い
  // Report を保全する設計のため、投稿を持つ Profile は削除できないままにする（docs/design.md §7「削除と退会」）
  user             Profile        @relation(fields: [userId], references: [id])
  bookId           String
  // onDelete未指定 = Restrict（意図的）。投稿が紐づく本は削除不可（管理画面の件数チェックとDBで二重ガード）
  book             Book           @relation(fields: [bookId], references: [id])
  title            String
  // 位置情報は媒体依存。「必須」はすべてアプリ層の検証（actions/report.ts の superRefine。UI と同条件を
  // サーバーでも強制）で、媒体に無関係な列を null に強制はしていない（UI が入力欄を出さないだけ）
  edition          Int?           // PAPER=必須（EBOOKは版・刷の概念を持たないため入力させない）
  printing         Int?           // PAPER=任意
  type             ReportType
  medium           Medium
  page             Int?           // PAPER=必須
  line             Int?           // PAPER=任意
  hasMultiplePages Boolean        @default(false) // PAPER 用（該当箇所が複数ページに及ぶ。表示はページ番号に「他」を付記）
  locationNote     String?        // PAPER=補足（任意）/ OTHER=位置メモ（必須）
  ebookLocation    String?        // EBOOK=必須（位置No・%・ページ等の自由記述）
  // 本文系も種別依存の条件付き必須（同じく superRefine）: ERRATA=wrong/correct 必須・
  // SUGGESTION/OTHER=content 必須。note は常に任意の補足
  wrong            String?
  correct          String?
  content          String?
  note             String?
  publisherComment String?
  status           ReportStatus @default(PENDING)
  // その誤りが「どの版・刷で直ったか」の出版社側の記録（投稿者が見つけた版 = edition とは別物）。
  // 紙は重版（刷）で直るのが普通なので実務の主役は fixedPrinting。status=FIXED のときだけ使う。
  fixedEdition     Int?
  fixedPrinting    Int?
  // 投稿者が見つけた「出版社の正誤表 URL」の申告（任意）。**公開ページには出さない**。
  // 管理者が管理画面で内容を確認し、妥当なら Book.erratumUrl に採用する（＝リンクの公開は管理者の判断を通す。
  // 外部リンクはフィッシング等の攻撃面になるため、監視の仕組み=通報機能ができるまでは開放しない）。
  reportedErratumUrl String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  images           ReportImage[]
  upvotes          Upvote[]

  // Postgres は FK 列にインデックスを自動作成しない（MySQL とはここが違う）。
  // bookId = 書籍ページ（books/[isbn]）の投稿一覧、userId = ユーザーページ（findReportsByUser）が毎回参照する
  @@index([bookId])
  @@index([userId])
}

// 賛同 — 「自分も同じ誤りを見つけた」の意思表示。1ユーザー1投稿につき1回（@@unique で担保）
model Upvote {
  id        String   @id @default(uuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([reportId, profileId])
  // reportId 側は上の複合ユニーク（先頭列）で兼ねられる。profileId 側は退会時の Cascade が参照する
  @@index([profileId])
}

// 操作ログ — 誰が・いつ・何を・どう変えたかを記録。
// 保持期間はプライバシーポリシー第6条2項に対応: 90日で自動削除（本番Supabaseに pg_cron ジョブ
// delete-old-audit-logs を手動登録済み＝リポジトリ管理外。登録SQLは docs/dev-environment.md §9 参照）
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  // 操作者のSupabase user UUID（システム操作はnull）。ProfileへのFKは意図的に張らない（ユーザー削除後もログを保全するため）
  userEmail  String?  // 操作者のメール（ユーザー削除後も記録が残るよう非正規化）
  action     String   // 例: "UPDATE_REPORT" "DELETE_REPORT" "UPDATE_USER_ROLE" "WITHDRAW_USER" "ADMIN_WITHDRAW_USER"（ベタ書き。網羅は grep で確認）
  targetType String   // "Report" | "Profile" | "PublisherAccess" | "Book" — 正解の文字列は src/constants/audit.ts の TARGET_TYPE に集約
  targetId   String   // 操作対象のID
  before     Json?    // 変更前の値
  after      Json?    // 変更後の値
  createdAt  DateTime @default(now())

  // 90日削除の pg_cron（createdAt < now() - 90 days）と管理画面の新着順表示が参照する
  @@index([createdAt])
}

// 投稿に添付する画像（枚数・サイズ・MIME の制約は src/constants/report-images.ts に集約。
// 上限チェックはフォームと API の両方で行う）。投稿の作成後にクライアントが別途アップロードする
// （Server Actions のボディ上限 1MB を超えるため、ここだけ Route Handler = api/reports/[id]/images）。
// 投稿削除時は DB の行を先に消し、Storage のファイル削除が失敗しても投稿削除は成立させる
// （孤児ファイルはログで追う = actions/report.ts）
model ReportImage {
  id         String   @id @default(uuid())
  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  imageUrl   String   // Supabase Storage 公開バケット report-images の公開URL
  createdAt  DateTime @default(now())

  // 投稿詳細の画像表示・投稿削除時の Cascade・アップロード時の枚数カウントが参照する
  @@index([reportId])
}

// レート制限のカウンタ（固定ウィンドウ）。しきい値は src/constants/rate-limits.ts、実装は src/lib/rate-limit.ts。
//
// なぜ DB に置くか: Vercel の関数はリクエストごとに使い捨てで、しかも複数インスタンスが並走するため
// プロセス内メモリでは数えられない（Fluid Compute のインスタンス再利用は保証にならない）。
// 共有ストアとして Redis を増やさず既存の Postgres を使う判断 — 関数(hnd1) と DB(日本) で
// リージョンが揃っていて往復が軽いこと、秘密情報を増やさないことが理由。
//
// これはアプリの本来のデータではない運用テーブル。他モデルから参照せず、消えても投稿は壊れない。
// 期限切れ行は pg_cron ジョブ delete-old-rate-limits が削除する
// （AuditLog の90日削除と同じ方式＝リポジトリ管理外。登録SQLは docs/dev-environment.md §9）
model RateLimit {
  key         String   // "<動作>:<ユーザーID>"（組み立ては src/lib/rate-limit.ts の rateLimitKey）
  windowStart DateTime // ウィンドウ（回数を数える時間の区切り）の開始時刻。現在時刻をウィンドウ幅で切り捨てた値なので、同じ区切りのリクエストが1行に集まる
  count       Int      // そのウィンドウで受け付けた回数。上限超過後も加算し続ける（判定は count <= limit）

  // (key, windowStart) の一意性が INSERT … ON CONFLICT の衝突条件そのもの。
  // これがあるおかげで「読んで+1して書く」を1クエリで原子的に行え、同時アクセスで数え落とさない
  @@id([key, windowStart])
  // 期限切れ行の一括削除（pg_cron）が参照する
  @@index([windowStart])
}
