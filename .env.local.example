# ローカル開発専用のテンプレート。これをコピーして .env.local を作る:
#   cp .env.local.example .env.local
#
# 値は `supabase start`（Docker 必要）の後、`supabase status` で確認できるローカル Supabase のもの。
# 本番値はここに書かない（本番・Preview は Vercel 環境変数で管理）。
# .env.local は gitignore 済み。Next.js は .env より .env.local を優先し、
# prisma.config.ts も .env.local を優先して読む（=ローカルで本番DBを叩かない）。

# ローカル Postgres（supabase status の DB_URL。プーラー無しなので両者とも同じ直結URL）
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# ローカル Supabase（supabase status の API_URL / PUBLISHABLE_KEY）
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<supabase status の PUBLISHABLE_KEY を貼る>"

# secret キー（旧 service_role の後継・サーバー専用・退会時の auth.users 削除に必要。supabase status の SECRET_KEY）
SUPABASE_SECRET_KEY="<supabase status の SECRET_KEY（sb_secret_…）を貼る>"

# Google Books API キー（ローカルでも書籍検索に必要。自分のキーを入れる）
GOOGLE_BOOKS_API_KEY="YOUR_GOOGLE_BOOKS_API_KEY"

# ローカル用 GitHub OAuth App（GitHubログインをローカルで動かす場合のみ必要）。
# github.com/settings/applications/new で callback = http://127.0.0.1:54321/auth/v1/callback
# のアプリを作成し、Client ID / client secret を貼る（本番用とは別アプリ。本番の値は
# Supabase ダッシュボードの Provider 設定に入れる）。
# supabase start がこのファイルを自動で読んで supabase/config.toml の env() に差し込む。
# 値を変えたら supabase stop && supabase start で反映。
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID="<GitHub OAuth App の Client ID>"
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET="<GitHub OAuth App の client secret>"

# ローカル用 Google OAuth クライアント（Googleログインをローカルで動かす場合のみ必要）。
# Google Cloud Console の「APIとサービス > 認証情報」で種類=ウェブアプリケーションの
# OAuth クライアントを作り、承認済みリダイレクト URI に
# http://127.0.0.1:54321/auth/v1/callback を登録して Client ID / client secret を貼る。
# ⚠️ 値を入れるだけでは有効にならない。supabase/config.toml の [auth.external.google] を
# enabled = true にしてから supabase stop && supabase start。
# ⚠️ 逆に client_id が空のまま enabled = true にすると `supabase start` 自体が失敗する
# （設定の読み込みで止まり、コンテナは1つも立ち上がらない）。
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID="<Google OAuth クライアントの Client ID>"
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET="<Google OAuth クライアントの client secret>"
