# Playwright のログイン済み e2e テスト用（確認済みのテストアカウント）。
# このファイルをコピーして .env.e2e を作り、値を入れる（.env.e2e はコミットされない）。
#
# 用意の仕方:
#   Supabase ダッシュボード → Authentication → Users → "Add user"
#   → メール確認済み（Auto Confirm User）でテスト専用アカウントを作成し、その認証情報を記入。
#
# 値が入っていれば、playwright test 実行時に自動でログイン済みテストが有効になる。
# 空のままなら認証テストはスキップされ、読み取り専用スモークのみ実行される。
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

# 任意: テスト対象のベースURL。未指定ならローカル dev (http://localhost:3000) を自動起動。
# 本番/プレビューに向ける場合に指定（その場合 dev は起動しない）。
# E2E_BASE_URL=https://errata-hub.vercel.app
