# このファイルをコピーして .env を作成し、各値を埋めてください。
#   cp .env.example .env
# 値はすべて自分の Supabase プロジェクト等から取得します（秘密情報はコミットしないこと）。

# --- データベース（Supabase の Project Settings → Database） ---
# アプリの通常クエリ用：コネクションプーラー（PgBouncer・ポート 6543）経由
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# マイグレーション用：DB への直接接続（ポート 5432）。PgBouncer 非対応のため必須
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Supabase Auth（Project Settings → API。これらは公開される前提・RLS で保護） ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_ANON_KEY"

# --- Google Books API（サーバーサイドのみ。NEXT_PUBLIC_ を付けない＝公開しない） ---
GOOGLE_BOOKS_API_KEY="YOUR_GOOGLE_BOOKS_API_KEY"
