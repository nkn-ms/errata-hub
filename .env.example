# このアプリが必要とする環境変数の一覧（＝変数の契約）。値の例は「ホスト型(本番)Supabase」のもの。
#
# 環境ごとの置き場所:
#   - ローカル開発  … `.env.local`（Supabase CLI のローカル値）。テンプレは .env.local.example を参照。
#   - 本番 / Preview … Vercel の環境変数で管理（このリポジトリには本番値を置かない）。
#   - このファイル   … 必要な変数を示すテンプレ。ホスト型 Supabase に自前で繋ぐ場合の例。
#
# ※ ローカル開発で本番DBを叩かないよう、prisma.config.ts は .env.local を優先して読む。

# --- データベース（ホスト型 Supabase の Project Settings → Database） ---
# アプリの通常クエリ用：コネクションプーラー（PgBouncer・ポート 6543）経由
#   ※ ローカル Supabase はプーラー無しのため DATABASE_URL と DIRECT_URL は同じ直結URLになる（.env.local.example 参照）。
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# マイグレーション用：DB への直接接続（ポート 5432）。PgBouncer 非対応のため必須
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Supabase Auth（Project Settings → API。これらは公開される前提・RLS で保護） ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_ANON_KEY"

# --- Google Books API（サーバーサイドのみ。NEXT_PUBLIC_ を付けない＝公開しない） ---
GOOGLE_BOOKS_API_KEY="YOUR_GOOGLE_BOOKS_API_KEY"
